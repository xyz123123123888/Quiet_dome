{
  "schemaVersion": 1,
  "id": "quiet_dome",
  "version": "${version}",
  "name": "Quiet Dome",
  "description": "A quiet dome over your client. Renders a per-machine alias across menus.",
  "authors": ["魔汐-INT"],
  "contact": {},
  "license": "GPL-3.0",
  "icon": "assets/quiet_dome/icon.png",
  "environment": "*",
  "entrypoints": {
    "client": ["com.quietdome.client.QuietDomeClient"]
  },
  "mixins": [
    { "config": "quiet_dome.client.mixins.json", "environment": "client" },
    { "config": "quiet_dome.viafabric.mixins.json", "environment": "client" },
    { "config": "quiet_dome.modmenu.mixins.json", "environment": "client" },
    { "config": "quiet_dome.options.mixins.json", "environment": "client" }
  ],
  "depends": {
    "fabricloader": ">=0.19.0",
    "minecraft": "~26.2",
    "java": ">=25",
    "fabric-api": "*"
  },
  "suggests": {
    "viafabric": "*",
    "modmenu": "*"
  }
}
